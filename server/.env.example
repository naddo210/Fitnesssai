# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas recommended for production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gymgenius?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL (for CORS)
CLIENT_URL=https://your-frontend.vercel.app

# Keep-Alive Configuration (Prevents Render.com free tier 15-minute sleep)
RENDER_EXTERNAL_URL=https://your-backend.onrender.com
SERVER_URL=https://your-backend.onrender.com

# AI Model Providers
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=
